# Copy to .env.local for local development / set in Railway Variables.
NEXT_PUBLIC_SITE_URL=https://www.regnerwerk.de
NEXT_PUBLIC_KONFIGURATOR_URL=https://konfigurator.example.com

# RegnerWerk Backend = Next.js Admin/CRM (NOT voice-gateway)
# Local: http://localhost:3001
# Prod:  https://admin-production-012a.up.railway.app
BACKEND_URL=http://localhost:3001
# Fallback if BACKEND_URL unset:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Telegram inbound leads (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Support-Chat: Gemini key lives on the Admin service (GEMINI_API_KEY), not on the site.
# Do not point BACKEND_URL at regnerwerk-backend-production (that is voice-gateway).
